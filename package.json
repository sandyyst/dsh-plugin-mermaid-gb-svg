{
  "name": "dsh-plugin-mermaid-gb-svg",
  "version": "0.1.3",
  "description": "DSH 插件：Mermaid 流程图 → GB/T 1526-1989（等同 ISO 5807）国标流程图 SVG，符号合规、正交走线、超 A4/A3 自动分页。DeepSeek Harness plugin: Mermaid flowcharts to GB/T 1526-1989 (ISO 5807) compliant flowchart SVG with A4/A3 pagination.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "mermaid",
    "mermaid-to-svg",
    "flowchart",
    "flowchart-symbols",
    "svg",
    "gb-t-1526",
    "gbt1526",
    "iso-5807",
    "国标",
    "流程图",
    "流程图符号",
    "a4"
  ],
  "author": "sandyyst",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandyyst/dsh-plugin-mermaid-gb-svg.git"
  },
  "homepage": "https://github.com/sandyyst/dsh-plugin-mermaid-gb-svg#readme",
  "bugs": {
    "url": "https://github.com/sandyyst/dsh-plugin-mermaid-gb-svg/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./engine": "./lib/engine.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "plugin": {
      "title": "Mermaid → GB/T 1526 SVG",
      "summary": "把 Mermaid 流程图转成符合 GB/T 1526-1989 图形符号的 SVG，支持超幅面自动分页。"
    }
  },
  "files": [
    "lib/index.js",
    "lib/engine.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "test": "node test/engine.test.mjs && node test/plugin.test.mjs",
    "prepublishOnly": "node test/engine.test.mjs && node test/plugin.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-sandbox": ">=0.0.1-rc.1 <0.0.2-0 || >=0.1.5-0 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.1.8-0 || >=0.1.8-0 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.0.2-0 || >=0.1.5-0 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.1.8-0 || >=0.1.8-0 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
